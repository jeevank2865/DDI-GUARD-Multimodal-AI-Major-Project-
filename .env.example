# Copy to .env, add a real key locally, then load it into the backend process.
# Never commit .env or expose this key in browser code.
DDI_GUARD_AI_PROVIDER=openai
DDI_GUARD_AI_MODEL=gpt-4.1-mini
DDI_GUARD_AI_API_KEY=replace-with-your-server-side-api-key

# The default frontend is served by this API and uses the same origin; leave these unset
# for the normal local run. For a separately hosted frontend, set the public API origin
# and list that frontend's exact HTTP(S) origin(s) for CORS. These values are public,
# not credentials. Never use '*' with credentials.
# DDI_GUARD_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# DDI_GUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# For a trusted OpenAI-compatible provider, set provider=openai_compatible and
# supply its HTTPS base URL. HTTP is accepted only for localhost development.
# DDI_GUARD_AI_PROVIDER=openai_compatible
# DDI_GUARD_AI_BASE_URL=https://api.example.com/v1
